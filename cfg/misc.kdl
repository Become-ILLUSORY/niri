    // 禁用热角功能（鼠标移到屏幕角落时触发动作）
    gestures {
        hot-corners {
            off
        }
    }
    
    prefer-no-csd
    // 截图保存路径，支持 strftime 格式化时间戳
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#screenshot-path
    screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

    environment {
        ELECTRON_OZONE_PLATFORM_HINT "auto"
        QT_QPA_PLATFORM "wayland"
        QT_QPA_PLATFORMTHEME "gtk3"
        QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
        XDG_CURRENT_DESKTOP "niri"
        XDG_SESSION_TYPE "wayland"

        // ArtCraft 套件(eGUI/winit)：X11 后端下 fcitx 输入法失效，强制原生 Wayland
        WINIT_UNIX_BACKEND "wayland"

    }

    cursor {
        xcursor-theme "MacTahoe-cursors"
        xcursor-size 24
    }

    // ─── 模糊效果 ───
    // 控制 background-effect 中 blur=true 时的全局模糊参数
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#blur
    blur {
        passes 3        // 模糊迭代次数，越多越模糊（性能开销也越大）
        offset 2.3      // 每次迭代的采样距离
        noise 0.001     // 噪点强度（0 = 无噪点），增加质感
        saturation 2    // 颜色饱和度增强倍数（1.0 = 原始，2.0 = 200%）
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }

    // ── 概览模式 ──
    // Mod+W 触发时显示所有工作区缩略图的外观
    overview {
        workspace-shadow {
            softness 60
            spread 20
            offset x=0 y=15
            color "#00000080"
        }
    }