layout {

    focus-ring {
        active-color   "#00628b"
        inactive-color "#f7f9fe"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#00628b"
        inactive-color "#f7f9fe"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#00628b"
        inactive-color "#007caf"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00628b80"
    }
}

recent-windows {
    highlight {
        active-color "#00628b"
        urgent-color "#ba1a1a"
    }
}
